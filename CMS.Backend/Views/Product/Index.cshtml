@model IEnumerable<CMS.Data.Entities.Product>

@{
   
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Tên trang của bạn";

}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold m-0">🛍️ Danh sách sản phẩm</h2>
        <a class="btn btn-success shadow-sm" href="/Product/Create">
            <i class="fas fa-plus"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;" class="text-center">Mã SP</th>
                        <th style="width: 100px;" class="text-center">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th class="text-center">Số lượng kho</th>
                        <th>Mô tả ngắn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-secondary">#@item.Id</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No Image</span>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td class="text-danger fw-bold">@item.Price.ToString("#,##0") đ</td>
                                <td class="text-center">
                                    @if (item.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-danger">Sắp hết hàng (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.StockQuantity</span>
                                    }
                                </td>
                                <td class="text-muted" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @item.Description
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <span class="d-block mb-2">📦</span> Chưa có dữ liệu sản phẩm trong database.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>