@model CMS.Data.Entities.Product
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Chỉnh sửa sản phẩm: @Model.Name</h2>
    <hr />

    <form asp-action="Edit" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Giá bán</label>
                    <input asp-for="Price" type="number" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Số lượng</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">URL Hình ảnh</label>
                    <input asp-for="ImageUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả ngắn</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}