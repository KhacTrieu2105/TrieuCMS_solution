<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrieuCMS.Backend</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    @* <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <header class="bg-white border-bottom shadow-sm">
        <div class="container py-2">
            <div class="d-flex justify-content-between align-items-center">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">TrieuCMS.Technology</a>

                <form class="d-flex w-50">
                    <input class="form-control me-2" type="search" placeholder="Tìm kiếm sản phẩm...">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                </form>

                <div class="d-flex align-items-center">
                    <a class="nav-link px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="nav-link px-3" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    <i class="bi bi-cart3 fs-4"></i>
                </div>
            </div>

            <nav class="nav justify-content-center mt-2 border-top pt-2">
                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>

                <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Cửa hàng</a>

                <a class="nav-link text-dark" asp-controller="Post" asp-action="Index">Tin tức / Blog</a>

                <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Về chúng tôi</a>
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CMS.Backend - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>