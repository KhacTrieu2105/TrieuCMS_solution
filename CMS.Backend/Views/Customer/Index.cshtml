@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<div class="container mt-4">
    <h2 class="mb-3 text-primary">👤 Bài tập 5: Danh sách khách hàng</h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã KH</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.Address</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu khách hàng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>