@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Danh sách khách hàng</h2>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm mới</a>
    </div>
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa khách hàng này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>