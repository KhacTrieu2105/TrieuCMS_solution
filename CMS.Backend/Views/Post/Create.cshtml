@model CMS.Data.Entities.Post

@{
    
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    ViewData["Title"] = "Thêm bài viết mới";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-file-earmark-plus"></i> THÊM BÀI VIẾT MỚI
            </h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Tiêu đề bài viết:</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tiêu đề..." required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Nội dung chi tiết:</label>
                            <textarea asp-for="Content" class="form-control" rows="12" placeholder="Viết nội dung tại đây..." required></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Chuyên mục:</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Tải ảnh đại diện:</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            <small class="text-muted d-block mt-1">Hỗ trợ các tệp tin hình ảnh định dạng phổ biến.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Ngày đăng:</label>
                            <input asp-for="CreatedDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="CreatedDate" class="text-danger"></span>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mb-2 py-2 shadow-sm">
                                <i class="bi bi-cloud-arrow-up"></i> Lưu và Đăng bài
                            </button>

                            <a asp-action="Index" class="btn btn-secondary btn-md w-100 py-2">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}