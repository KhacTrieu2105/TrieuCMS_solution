@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Tạo bài viết mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">✍️ Tạo bài viết mới</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề bài viết:</label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề hấp dẫn..." required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chuyên mục bài viết:</label>
                            <select asp-for="CategoryId" class="form-select" required>
                                <option value="">-- Chọn chuyên mục --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Đường dẫn hình ảnh (URL):</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="Ví dụ: /images/posts/tin-tuc.jpg" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nội dung chi tiết bài viết:</label>
                            <textarea asp-for="Content" class="form-control" rows="8" placeholder="Viết nội dung bài viết vào đây..." required></textarea>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Hủy bỏ quay lại
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-cloud-upload"></i> Lưu vào hệ thống
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>