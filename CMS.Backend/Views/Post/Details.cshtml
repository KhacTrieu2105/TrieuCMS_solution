@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-primary fw-bold mb-3">@Model.Title</h1>

            <div class="mb-4">
                <span class="badge bg-info text-dark py-2 px-3">🏷️ Chuyên mục: @Model.Category?.Name</span>
                <span class="text-muted ms-3">📅 Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm w-100 mb-4" alt="Thumbnail" style="max-height: 400px; object-fit: cover;">
            }

            <div class="card shadow-sm mb-4">
                <div class="card-body" style="font-size: 1.1rem; line-height: 1.8; white-space: pre-line;">
                    @Model.Content
                </div>
            </div>

            <a href="/Post" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách bài viết
            </a>
        </div>
    </div>
</div>