@model CMS.Data.Entities.CategoryProduct
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm danh mục sản phẩm mới</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả..."></textarea>
                </div>

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-lg"></i> Thêm mới
                </button>
                <a asp-action="Index" class="btn btn-secondary px-3">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>