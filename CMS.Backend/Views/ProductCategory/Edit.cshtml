@model CMS.Data.Entities.CategoryProduct
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa danh mục: @Model.Name</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-save"></i> Cập nhật thay đổi
                </button>
                <a asp-action="Index" class="btn btn-secondary px-3">Quay lại</a>
            </form>
        </div>
    </div>
</div>