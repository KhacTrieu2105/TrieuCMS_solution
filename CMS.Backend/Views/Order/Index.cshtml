@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container mt-4">
    <h2 class="mb-3 text-success">📦 Bài tập 6: Danh sách đơn hàng</h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Đơn hàng</th>
                        <th>Mã Khách hàng</th>
                        <th>Ngày đặt hàng</th>
                        <th>Trạng thái (Status)</th>
                        <th>Ghi chú (Notes)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>KH-0@item.CustomerId</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark">Mới tạo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                </td>
                                <td class="text-muted">@item.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu đơn hàng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>